# Copia este archivo como .env y completa los valores reales:
#   copy .env.example .env      (Windows CMD)
#   cp .env.example .env        (Linux / macOS)
# NUNCA subas el archivo .env al repositorio.

# ===== OpenWeather =====
# Consigue tu key gratis en https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# ===== PostgreSQL =====
POSTGRES_DB=weather
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=change_me
# "db" es el nombre del servicio en docker-compose (no localhost)
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== Django =====
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=True
# Hosts desde los que Django acepta peticiones, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontends autorizados a llamar la API desde el navegador (CORS), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Redis =====
# "redis" es el nombre del servicio en docker-compose
REDIS_URL=redis://redis:6379/0
# Tiempo que un dato del clima vive en cache, en segundos (600 = 10 minutos)
WEATHER_CACHE_TTL_SECONDS=600

# Celery: broker (base de datos 1 de Redis, separada de la caché)
CELERY_BROKER_URL=redis://redis:6379/1
# Ciudades que se refrescan automáticamente, separadas por coma
WEATHER_TRACKED_CITIES=Bogota,Medellin,Cali,Cartagena
# Cada cuántos segundos se refrescan (600 = 10 minutos)
WEATHER_REFRESH_SECONDS=600


# ===== Agente (Parte B) =====
# Modelo en formato LiteLLM "proveedor/modelo". Cambiarlo NO requiere tocar el código.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# API key del proveedor del modelo (Gemini: https://aistudio.google.com)
LLM_API_KEY=

# Modelos de respaldo si el principal está saturado o sin cupo, separados por coma
LLM_FALLBACK_MODELS=gemini/gemini-3.1-flash-lite

# ===== Producción (solo en el servidor) =====
# Dominio público; Caddy saca el certificado HTTPS para él
SITE_DOMAIN=
# Proxies delante de Django (1 con Caddy); 0 en local
DJANGO_NUM_PROXIES=0
