# Copia este archivo como .env y completa los valores reales:
#   copy .env.example .env      (Windows CMD)
#   cp .env.example .env        (Linux / macOS)
# NUNCA subas el archivo .env al repositorio.

# ===== OpenWeather =====
# Consigue tu key gratis en https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# ===== PostgreSQL =====
POSTGRES_DB=weather
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=change_me
# "db" es el nombre del servicio en docker-compose (no localhost)
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== Django =====
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=True

# ===== Redis =====
# "redis" es el nombre del servicio en docker-compose
REDIS_URL=redis://redis:6379/0
# Tiempo que un dato del clima vive en cache, en segundos (600 = 10 minutos)
WEATHER_CACHE_TTL_SECONDS=600
